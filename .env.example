# Government Polytechnic Madhogarh Library Portal Environment Configuration

# Security
SECRET_KEY=django-insecure-replace-this-key-in-production-with-a-strong-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,gpmadhogarh.ac.in,library.gpmadhogarh.ac.in

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL in production:
# DATABASE_URL=postgres://gpm_library_user:secure_password@localhost:5432/gpm_library_db

# Static & Media Storage
STATIC_ROOT=/var/www/gpm_library/staticfiles
MEDIA_ROOT=/var/www/gpm_library/media

# Institutional Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=library.gpmadhogarh@gmail.com
EMAIL_HOST_PASSWORD=app-specific-password
DEFAULT_FROM_EMAIL=Central Library GP Madhogarh <library.gpmadhogarh@gmail.com>

# Security Headers (Set True in Production with HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://gpmadhogarh.ac.in,https://library.gpmadhogarh.ac.in

